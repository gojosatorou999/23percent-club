# Production values live in your hosting dashboard (e.g. Vercel), never in git.

# Canonical site URL, used for SEO metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://23percentclub.com

# Cookie-free page analytics (Plausible). Leave disabled for local development.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=23percentclub.com
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Supabase (optional). With both set, accounts and progress sync across devices.
# Leave blank to keep accounts on each visitor's device only.
# Find these in Supabase > Project Settings > API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
